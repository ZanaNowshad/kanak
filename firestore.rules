rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PostgreSQL owns tenant roles and financial writes. Deny all direct
    // client writes until server-provisioned, tenant-scoped paths exist.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
    match /invoices/{invoiceId} { allow read, write: if false; }
    match /company_registrations/{registrationId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
